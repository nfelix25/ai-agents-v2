{
  "name": "agi",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "agi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "eval": "npx lmnr eval",
    "eval:file-tools": "npx lmnr eval evals/file-tools.eval.ts",
    "eval:shell-tools": "npx lmnr eval evals/shell-tools.eval.ts",
    "eval:agent": "npx lmnr eval evals/agent-multiturn.eval.ts",
    "eval:compaction": "tsx evals/compaction-quality.eval.ts",
    "eval:compaction:a": "tsx evals/compaction-quality.eval.ts --strategy=A",
    "eval:compaction:b": "tsx evals/compaction-quality.eval.ts --strategy=B",
    "eval:compaction:compare": "npm run eval:compaction:a && npm run eval:compaction:b",
    "eval:compaction:a:normalized": "tsx evals/compaction-quality.eval.ts --strategy=A --prompt-profile=normalized",
    "eval:compaction:b:normalized": "tsx evals/compaction-quality.eval.ts --strategy=B --prompt-profile=normalized",
    "eval:compaction:compare:normalized": "npm run eval:compaction:a:normalized && npm run eval:compaction:b:normalized",
    "eval:compaction:compare:normalized:capped": "tsx evals/compaction-quality.eval.ts --strategy=A --prompt-profile=normalized --summary-max-output-tokens=500 && tsx evals/compaction-quality.eval.ts --strategy=B --prompt-profile=normalized --summary-max-output-tokens=500",
    "eval:compaction:report": "tsx evals/compare-compaction-insights.ts",
    "eval:compaction-agent": "tsx evals/agent-after-compaction.eval.ts",
    "eval:all-compaction": "npm run eval:compaction && npm run eval:compaction-agent"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.72",
    "@lmnr-ai/lmnr": "^0.7.9",
    "@types/shelljs": "^0.8.17",
    "ai": "^5.0.102",
    "dotenv": "^17.2.3",
    "ink": "^6.5.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "shelljs": "^0.10.0",
    "zod": "^4.1.13"
  }
}
